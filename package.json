{
  "name": "wger-mcp",
  "version": "0.1.0",
  "description": "Remote MCP server bridging claude.ai to a self-hosted wger instance",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "npm run typecheck && node --test \"test/unit/**/*.test.ts\"",
    "test:e2e": "node --test \"test/e2e/**/*.test.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "typescript": "~5.9.3"
  }
}
